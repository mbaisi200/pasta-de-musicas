# ============================================================
# Pasta de Músicas — variáveis de ambiente
#
# Copie este arquivo e preencha com os dados do SEU projeto Firebase:
#     cp .env.example .env.local
#
# O .env.local é ignorado pelo Git — nunca versione suas credenciais.
# ============================================================

# --- Firebase Admin SDK (servidor) ---
# Firebase Console > Configurações do projeto > Contas de serviço
# > "Gerar nova chave privada" (baixa um JSON com estes dois campos).
# A chave privada deve ficar entre aspas, com os \n literais, numa única linha.
#
# Atalho: depois de baixar o JSON, rode
#   npm run config:env -- ~/Downloads/chave-do-firebase.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"

# --- Firebase Web SDK (OPCIONAL) ---
# O login é feito pelo SERVIDOR (Identity Toolkit admin) — estas variáveis
# só são necessárias para recursos que rodam no navegador (recuperação de
# senha por e-mail, verificação de e-mail, login social no futuro).
# Grave com: npm run config:env -- <chave-do-web.json>
# Firebase Console > Configurações do projeto > Seus apps > app Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- App ---
# URL pública do app (usada no manifest e nos links de compartilhamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000
